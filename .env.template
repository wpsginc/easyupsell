# EasyUpsell Configuration
# Copy this file to .env and fill in your credentials

# =============================================================================
# NetSuite TBA Credentials
# =============================================================================
# See pim-sync/DOCS/ARCHITECTURE.md for setup instructions
# Account ID format: Use underscore and UPPERCASE for OAuth realm
# Example: 5001161_SB1 (not 5001161-sb1)

NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=

# =============================================================================
# BigCommerce API
# =============================================================================
# Generate at: BC Admin → Settings → API → Create API Account
# Required scopes: Products (modify), Orders (read)

BC_STORE_HASH=
BC_ACCESS_TOKEN=

# =============================================================================
# LLM Provider (for category validation)
# =============================================================================
# Option 1: Azure OpenAI (Recommended)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_BASE=https://your-instance.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Option 2: OpenAI Direct
# OPENAI_API_KEY=

# Option 3: Local Ollama
# OLLAMA_HOST=http://localhost:11434

# Option 4: LiteLLM Proxy (Moltbot/Athena)
# LITELLM_HOST=http://localhost:4000
# LITELLM_API_KEY=
# LITELLM_MODEL=gpt-4o-mini
